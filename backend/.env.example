# GitHub OAuth Configuration
# Get these from https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth Callback URL (update for production)
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8001/api/auth/github/callback

# Encryption Key for Token Storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# Legacy GitHub Token (for public API access fallback)
GITHUB_TOKEN=your_github_personal_access_token_here

# Database URL (configured in docker-compose)
DATABASE_URL=postgresql+psycopg2://postgres:asep_password@localhost:5432/asep

# Frontend URL (for CORS)
FRONTEND_URL=chrome-extension://*